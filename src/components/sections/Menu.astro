---
const cups = [
    {
        key: "latte",
        title: "Latte",
        description: "Velvety · Sweet · Balanced",
        imageSrc: "/assets/latte.png",
    },
    {
        key: "espresso",
        title: "Espresso",
        description: "Rich · Complex · Timeless",
        imageSrc: "/assets/espresso.png",
    },
    {
        key: "flat-white",
        title: "Flat White",
        description: "Bold · Silky · Intense",
        imageSrc: "/assets/flat-white.png",
    },
];
---

<section class="cup-selector">
    <div class="cup-selector-sticky">
        <div class="cup-selector-header">
            <span>MENU</span>
            <span>SEASON 2026</span>
        </div>

        <div class="cup-selector-content">
            <div class="cup-selector-copy">
                <span class="cup-selector-kicker">
                    THREE WAYS. ONE RITUAL.
                </span>

                <h2>
                    <span>CHOOSE</span>
                    <span>YOUR CUP.</span>
                </h2>
            </div>

            <div class="cup-stage">
                {
                    cups.map((cup, index) => (
                        <article
                            class={`cup-card ${cup.key} ${
                                index === 1 ? "is-active" : ""
                            }`}
                            data-index={index}
                        >
                            <div class="cup-image-wrap">
                                <img
                                    src={cup.imageSrc}
                                    alt={cup.title}
                                    class="cup-image"
                                />
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>

        <div class="cup-selector-meta">
            {
                cups.map((cup, index) => (
                    <article
                        class={`cup-meta ${index === 1 ? "is-active" : ""}`}
                        data-index={index}
                    >
                        <h3>{cup.title}</h3>
                        <p>{cup.description}</p>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    window.addEventListener("load", () => {
        const section = document.querySelector(".cup-selector");
        const sticky = document.querySelector(".cup-selector-sticky");

        const cards = Array.from(
            document.querySelectorAll(".cup-card"),
        );

        const metas = Array.from(
            document.querySelectorAll(".cup-meta"),
        );

        const metaContainer = document.querySelector(
            ".cup-selector-meta",
        );

        const titleLines = document.querySelectorAll(
            ".cup-selector-copy h2 span",
        );

        const kicker = document.querySelector(
            ".cup-selector-kicker",
        );

        const header = document.querySelectorAll(
            ".cup-selector-header > *",
        );

        if (!section || !sticky || !cards.length) return;

        /* =========================
           CUP POSITIONS
           ========================= */

        const positions = {
            left: {
                xPercent: -70,
                yPercent: 4,
                scale: 0.45,
                opacity: 0.8,
                rotation: -2.5,
                zIndex: 1,
            },

            center: {
                xPercent: 0,
                yPercent: 0,
                scale: 1,
                opacity: 1,
                rotation: 0,
                zIndex: 3,
            },

            right: {
                xPercent: 70,
                yPercent: 4,
                scale: 0.45,
                opacity: 0.8,
                rotation: 2.5,
                zIndex: 1,
            },
        };

        /*
         * 0 = Latte
         * 1 = Espresso
         * 2 = Flat White
         */

        const stateOrder = [
            ["center", "right", "left"],
            ["left", "center", "right"],
            ["right", "left", "center"],
        ];

        /* =========================
           CUP TRANSITION
           ========================= */

        const setCardState = (
            card,
            state,
            immediate = false,
        ) => {
            const config = positions[state];

            if (immediate) {
                gsap.set(card, config);

                return;
            }

            gsap.to(card, {
                ...config,

                duration: 1.35,

                ease: "power3.out",

                overwrite: "auto",
            });
        };

        /* =========================
           META TRANSITION
           ========================= */

        let activeMetaIndex = 1;

        const setActiveMeta = (
            nextIndex,
            immediate = false,
        ) => {
            if (
                nextIndex === activeMetaIndex &&
                !immediate
            ) {
                return;
            }

            const previousMeta =
                metas[activeMetaIndex];

            const nextMeta =
                metas[nextIndex];

            activeMetaIndex = nextIndex;

            if (immediate) {
                metas.forEach((meta, index) => {
                    gsap.set(meta, {
                        opacity:
                            index === nextIndex
                                ? 1
                                : 0,

                        y:
                            index === nextIndex
                                ? 0
                                : 8,

                        visibility:
                            index === nextIndex
                                ? "visible"
                                : "hidden",
                    });
                });

                return;
            }

            if (previousMeta) {
                gsap.to(previousMeta, {
                    opacity: 0,
                    y: -6,

                    duration: 0.3,

                    ease: "power2.out",

                    overwrite: true,

                    onComplete: () => {
                        gsap.set(previousMeta, {
                            visibility: "hidden",
                        });
                    },
                });
            }

            if (nextMeta) {
                gsap.set(nextMeta, {
                    visibility: "visible",
                    opacity: 0,
                    y: 8,
                });

                gsap.to(nextMeta, {
                    opacity: 1,
                    y: 0,

                    duration: 0.65,

                    delay: 0.08,

                    ease: "power3.out",

                    overwrite: true,
                });
            }
        };

        /* =========================
           ACTIVE STATE
           ========================= */

        const setActiveState = (
            activeIndex,
            immediate = false,
        ) => {
            const order =
                stateOrder[activeIndex];

            cards.forEach((card, index) => {
                const state = order[index];

                setCardState(
                    card,
                    state,
                    immediate,
                );

                card.classList.toggle(
                    "is-active",
                    state === "center",
                );
            });

            setActiveMeta(
                activeIndex,
                immediate,
            );
        };

        /*
         * Initial state:
         * Espresso centered.
         */

        setActiveState(1, true);

        /* =========================
           INTRO
           ========================= */

        gsap.set(header, {
            y: 18,
            opacity: 0,
        });

        gsap.set(kicker, {
            y: 20,
            opacity: 0,
        });

        gsap.set(titleLines, {
            y: 42,
            opacity: 0,
        });

        gsap.set(metaContainer, {
            y: 20,
            opacity: 0,
        });

        const intro = gsap.timeline({
            scrollTrigger: {
                trigger: section,
                start: "top 72%",
                once: true,
            },
        });

        intro
            .to(header, {
                y: 0,
                opacity: 1,

                duration: 0.8,
                stagger: 0.08,

                ease: "power3.out",
            })

            .to(
                kicker,
                {
                    y: 0,
                    opacity: 1,

                    duration: 0.8,

                    ease: "power3.out",
                },
                "-=0.45",
            )

            .to(
                titleLines,
                {
                    y: 0,
                    opacity: 1,

                    duration: 1.15,
                    stagger: 0.1,

                    ease: "power3.out",
                },
                "-=0.5",
            )

            .to(
                metaContainer,
                {
                    y: 0,
                    opacity: 1,

                    duration: 0.9,

                    ease: "power3.out",
                },
                "-=0.7",
            );

        /* =========================
           SCROLL STATES
           ========================= */

        let currentIndex = 1;

        ScrollTrigger.create({
            trigger: sticky,

            start: "top top",

            end: () =>
                `+=${window.innerHeight * 8}`,

            pin: true,
            pinSpacing: true,

            invalidateOnRefresh: true,
            anticipatePin: 1,

            onUpdate: (self) => {
                const progress =
                    self.progress;

                /*
                 * 0% ───────────── 22%
                 * Espresso remains untouched.
                 *
                 * This is the initial dead zone.
                 */

                let nextIndex = 1;

                /*
                 * 22% ──────────── 55%
                 * Latte becomes active.
                 */

                if (progress >= 0.22) {
                    nextIndex = 0;
                }

                /*
                 * 55% ──────────── 100%
                 * Flat White becomes active.
                 *
                 * Because there are no more
                 * state changes, the final portion
                 * naturally becomes a dead zone too.
                 */

                if (progress >= 0.55) {
                    nextIndex = 2;
                }

                if (
                    nextIndex === currentIndex
                ) {
                    return;
                }

                currentIndex =
                    nextIndex;

                setActiveState(
                    currentIndex,
                );
            },
        });
    });
</script>

<style>
    /* =========================
       SECTION
       ========================= */

    .cup-selector {
        margin-top: 16vh;
        padding-inline: 4rem;
    }

    .cup-selector-sticky {
        position: relative;

        width: 100%;
        height: 100svh;

        display: grid;
        grid-template-rows: auto 1fr;

        overflow: hidden;
    }

    /* =========================
       HEADER
       ========================= */

    .cup-selector-header {
        position: relative;
        z-index: 10;

        display: flex;
        justify-content: space-between;

        padding-top: 2.5rem;

        font-size: 0.68rem;
        letter-spacing: 0.22em;

        text-transform: uppercase;
    }

    /* =========================
       MAIN COMPOSITION
       ========================= */

    .cup-selector-content {
        position: relative;

        width: 100%;

        min-width: 0;
        min-height: 0;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        padding-bottom: 2rem;
    }

    /* =========================
       TITLE
       ========================= */

    .cup-selector-copy {
        position: relative;
        z-index: 5;

        width: 100%;

        text-align: center;

        pointer-events: none;
    }

    .cup-selector-kicker {
        display: block;

        margin-bottom: 1rem;

        font-size: 0.65rem;
        letter-spacing: 0.3em;

        text-transform: uppercase;

        opacity: 0.55;
    }

    .cup-selector-copy h2 {
        margin: 0;
    }

    .cup-selector-copy h2 span {
        display: block;

        font-size: clamp(4rem, 9vw, 9.5rem);
        line-height: 0.78;

        font-weight: 900;
        letter-spacing: -0.075em;

        text-transform: uppercase;
    }

    /* =========================
       CUP STAGE
       ========================= */

    .cup-stage {
        position: relative;

        width: 100%;
        height: clamp(20rem, 45vh, 32rem);

        display: grid;
        place-items: center;

        margin-top: -1.5rem;
    }

    .cup-card {
        position: relative;

        grid-column: 1;
        grid-row: 1;

        width: min(35vw, 28rem);

        transform-origin: center;

        will-change: transform, opacity;
    }

    .cup-image-wrap {
        width: 100%;
        aspect-ratio: 1;

        display: grid;
        place-items: center;
    }

    .cup-image {
        width: 100%;
        height: 100%;

        object-fit: contain;

        filter: drop-shadow(0 2rem 2.5rem rgba(59, 36, 20, 0.14));

        transition:
            filter 0.6s ease,
            transform 0.6s ease;
    }

    .cup-card:not(.is-active) .cup-image {
        filter: blur(1px) drop-shadow(0 1rem 1.5rem rgba(59, 36, 20, 0.1));
    }

    .cup-card.is-active .cup-image {
        transform: translateY(-0.4rem);
    }

    /* =========================
       FIXED CUP META
       ========================= */

    .cup-selector-meta {
        position: absolute;

        left: 0;
        bottom: 2.75rem;

        z-index: 10;

        width: min(24rem, 28vw);
        min-height: 5rem;

        pointer-events: none;
    }

    .cup-meta {
        position: absolute;

        left: 0;
        bottom: 0;

        width: 100%;

        opacity: 0;
        visibility: hidden;

        transition:
            opacity 0.4s ease,
            visibility 0.4s;
    }

    .cup-meta.is-active {
        opacity: 1;
        visibility: visible;

        transform: translateY(0);
    }

    .cup-meta h3 {
        margin: 0;

        font-family: var(--font-serif);

        font-size: clamp(1.8rem, 2.7vw, 3.4rem);

        font-weight: 400;
        line-height: 0.9;

        letter-spacing: -0.05em;
    }

    .cup-meta p {
        margin-top: 0.75rem;

        font-size: 0.62rem;
        line-height: 1.4;

        letter-spacing: 0.2em;

        text-transform: uppercase;

        opacity: 0.55;
    }

    /* =========================
       TABLET
       ========================= */

    @media (width <= 1024px) {
        .cup-selector {
            margin-top: 10vh;

            padding-inline: 2rem;
        }

        .cup-selector-header {
            padding-top: 2rem;

            font-size: 0.62rem;
        }

        .cup-selector-content {
            padding-bottom: 1rem;
        }

        .cup-selector-kicker {
            margin-bottom: 0.9rem;

            font-size: 0.58rem;
        }

        .cup-selector-copy h2 span {
            font-size: clamp(4rem, 11vw, 7rem);
        }

        .cup-stage {
            height: clamp(19rem, 46vh, 29rem);

            margin-top: -1rem;
        }

        .cup-card {
            width: min(34vw, 20rem);
        }

        .cup-selector-meta {
            bottom: 2rem;

            width: min(21rem, 40vw);
        }

        .cup-meta h3 {
            font-size: clamp(2rem, 4vw, 3.5rem);
        }
    }

    /* =========================
       MOBILE
       ========================= */

    @media (width <= 600px) {
        .cup-selector {
            margin-top: 6vh;

            padding-inline: 1rem;
        }

        .cup-selector-header {
            padding-top: 1.5rem;

            font-size: 0.55rem;
            letter-spacing: 0.16em;
        }

        .cup-selector-content {
            padding-bottom: 4.5rem;
        }

        .cup-selector-kicker {
            margin-bottom: 0.8rem;

            font-size: 0.52rem;
            letter-spacing: 0.2em;
        }

        .cup-selector-copy h2 span {
            font-size: clamp(3.3rem, 15vw, 5.4rem);

            line-height: 0.8;
        }

        .cup-stage {
            height: min(46vh, 27rem);

            margin-top: 0;
        }

        .cup-card {
            width: min(62vw, 18rem);
        }

        .cup-selector-meta {
            left: 50%;
            bottom: 1.5rem;

            width: calc(100% - 2rem);

            text-align: center;

            transform: translateX(-50%);
        }

        .cup-meta h3 {
            font-size: clamp(2rem, 9vw, 3rem);
        }

        .cup-meta p {
            margin-top: 0.55rem;

            font-size: 0.52rem;
            letter-spacing: 0.14em;
        }
    }

    /* =========================
       SHORT VIEWPORT
       ========================= */

    @media (max-height: 700px) and (min-width: 700px) {
        .cup-selector-header {
            padding-top: 1.25rem;
        }

        .cup-selector-kicker {
            margin-bottom: 0.6rem;
        }

        .cup-selector-copy h2 span {
            font-size: min(8vw, 10vh);
        }

        .cup-stage {
            height: 43vh;

            margin-top: -0.5rem;
        }

        .cup-card {
            width: min(25vw, 38vh);
        }

        .cup-selector-meta {
            bottom: 1.25rem;
        }

        .cup-meta h3 {
            font-size: min(3vw, 4.5vh);
        }
    }

    /* =========================
       VERY SHORT VIEWPORT
       ========================= */

    @media (max-height: 560px) and (min-width: 700px) {
        .cup-selector-header {
            padding-top: 1rem;
        }

        .cup-selector-kicker {
            display: none;
        }

        .cup-selector-copy h2 span {
            font-size: min(7vw, 9vh);
        }

        .cup-stage {
            height: 39vh;

            margin-top: 0;
        }

        .cup-card {
            width: min(21vw, 32vh);
        }

        .cup-selector-meta {
            bottom: 0.75rem;
        }

        .cup-meta h3 {
            font-size: min(2.7vw, 4vh);
        }

        .cup-meta p {
            display: none;
        }
    }
</style>
