<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    window.addEventListener("load", () => {
        const section = document.querySelector(".menu");
        const header = document.querySelectorAll(".menu-header > *");
        const items = document.querySelectorAll(".menu-item");

        gsap.set(header, {
            y: 24,
            opacity: 0,
        });

        gsap.set(items, {
            "--line-scale": 0,
            y: 42,
            opacity: 0,
        });

        gsap.to(header, {
            y: 0,
            opacity: 1,
            duration: 0.8,
            stagger: 0.08,
            ease: "power4.out",
            scrollTrigger: {
                trigger: section,
                start: "top 72%",
                once: true,
            },
        });

        gsap.to(items, {
            "--line-scale": 1,
            y: 0,
            opacity: 1,
            duration: 1,
            stagger: 0.12,
            ease: "power4.out",
            scrollTrigger: {
                trigger: ".menu-list",
                start: "top 78%",
                once: true,
            },
        });
    });
</script>

